#!/bin/sh
# 供 LuCI 网页调用：立即返回，后台运行 ota-check，结果写入 /tmp/ota-check-ui.out。
# 页面轮询该文件直到出现 __OTA_DONE_<exitcode>__ 标记。
# 子进程的 stdout/stderr 必须全部重定向走，否则 rpcd 的 file exec
# 会一直等管道 EOF，网页按钮就永远转圈。
#
# 并发锁：同一时间只允许一个后台检测/下载任务（/tmp/ota-check-ui.lock/pid 存活 PID）。
# 重复触发时输出 OTA_BUSY 且不清空输出文件，页面检测到 OTA_BUSY 后直接转入
# 轮询，展示正在运行任务的实时进度。没有锁时连点/多标签页会同时向同一个
# 输出文件写入，输出交织、下载中的镜像互相截断。
# 锁通过 /proc/<pid> 与 kill -0 复核进程存活；进程死亡后自动接管残留锁。

OUT="${OTA_UI_OUT:-/tmp/ota-check-ui.out}"
LOCK="${OTA_UI_LOCK:-/tmp/ota-check-ui.lock}"
OTA_CHECK_BIN="${OTA_CHECK_BIN:-/usr/bin/ota-check}"
umask 077

# rpcd callers can invoke this file without going through the page buttons.
# Keep firmware flashing and arbitrary sysupgrade arguments out of this API.
_expect=""
_source_seen=0
_version_seen=0
_download_seen=0
for _arg in "$@"; do
  case "$_expect" in
    source)
      case "$_arg" in github|gitee) ;; *) echo "无效更新源" >&2; exit 2 ;; esac
      _expect=""
      continue
      ;;
    version)
      printf '%s\n' "$_arg" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || {
        echo "无效固件版本" >&2; exit 2;
      }
      _expect=""
      continue
      ;;
  esac
  case "$_arg" in
    --source) [ "$_source_seen" = 0 ] || exit 2; _source_seen=1; _expect=source ;;
    --version) [ "$_version_seen" = 0 ] || exit 2; _version_seen=1; _expect=version ;;
    --download) [ "$_download_seen" = 0 ] || exit 2; _download_seen=1 ;;
    *) echo "网页接口不支持参数: $_arg" >&2; exit 2 ;;
  esac
done
[ -z "$_expect" ] || { echo "参数缺少取值" >&2; exit 2; }

lock_active() {
  [ -f "$LOCK/pid" ] || return 1
  _pid=$(cat "$LOCK/pid" 2>/dev/null)
  case "$_pid" in
    '' | *[!0-9]*) return 1 ;;
  esac
  [ -d "/proc/$_pid" ] || return 1
  kill -0 "$_pid" 2>/dev/null
}

acquire_lock() {
  if [ -e "$LOCK" ]; then
    [ -d "$LOCK" ] && [ ! -L "$LOCK" ] || {
      echo "后台任务锁路径不安全: $LOCK" >&2; return 2;
    }
    # An owner that has not published its PID yet must still keep its lock.
    if [ ! -s "$LOCK/pid" ] || lock_active; then
      echo "OTA_BUSY"
      return 1
    fi
    # Serialize stale-lock recovery inside the existing lock, then recheck:
    # another contender may already have replaced the stale directory.
    mkdir "$LOCK/reclaim" 2>/dev/null || { echo "OTA_BUSY"; return 1; }
    if [ ! -s "$LOCK/pid" ] || lock_active; then
      rmdir "$LOCK/reclaim" 2>/dev/null
      echo "OTA_BUSY"
      return 1
    fi
    # Keep the lock directory in place while replacing a stale owner. Removing
    # and recreating it opens a gap where every contender can report busy and
    # leave an empty lock behind.
    _reclaim_pid="$LOCK/pid.reclaim.$$"
    if ! printf '%s\n' "$$" > "$_reclaim_pid" || ! mv -f "$_reclaim_pid" "$LOCK/pid"; then
      rm -f "$_reclaim_pid"
      rmdir "$LOCK/reclaim" 2>/dev/null
      echo "无法更新后台任务锁" >&2
      return 2
    fi
    rmdir "$LOCK/reclaim" 2>/dev/null || {
      echo "无法释放后台任务恢复锁" >&2
      return 2
    }
    return 0
  fi

  # mkdir is atomic on the router filesystem; unlike a file existence check,
  # this closes the TOCTOU window when two LuCI requests arrive together.
  if ! mkdir "$LOCK" 2>/dev/null; then
    # The winner owns its newly created directory even before publishing PID.
    # Never remove that directory after losing the atomic mkdir race.
    [ -d "$LOCK" ] && { echo "OTA_BUSY"; return 1; }
    echo "无法创建后台任务锁: $LOCK" >&2
    return 2
  fi
  printf '%s\n' "$$" > "$LOCK/pid"
  return 0
}

acquire_lock
_lock_rc=$?
if [ "$_lock_rc" -ne 0 ]; then
  # A busy request is an expected UI path and must remain a successful rpcd
  # call; genuine lock setup errors should still be reported as failures.
  [ "$_lock_rc" -eq 1 ] && exit 0
  exit "$_lock_rc"
fi

# Remove a pre-existing symlink instead of following it as root.
rm -f "$OUT" || { rm -rf "$LOCK"; exit 2; }
# Open once with noclobber, then inherit the descriptor. A local process cannot
# redirect root's later writes by replacing the public polling path with a link.
set -C
if ! {
  ( "$OTA_CHECK_BIN" "$@" >&3 2>&1; _rc=$?; printf '__OTA_DONE_%s__\n' "$_rc" >&3; rm -rf "$LOCK" ) >/dev/null 2>&1 &
  printf '%s\n' "$!" >| "$LOCK/pid" 2>/dev/null || :
  echo "已启动后台检测"
} 3> "$OUT"; then
  rm -rf "$LOCK"
  exit 2
fi
